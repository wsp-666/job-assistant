# ========== 会员云服务器专用 ==========
# 只存用户/会员/订单，不存岗位简历

DEPLOYMENT_ROLE=cloud
DB_BACKEND=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=job_assistant
MYSQL_PASSWORD=请改成宝塔数据库密码
MYSQL_DATABASE=job_assistant

PUBLIC_BASE_URL=http://你的会员云地址
LOCAL_APP_URL=http://127.0.0.1:8000

AUTH_ENABLED=true
DEV_LOGIN_ENABLED=false
JWT_SECRET=随机长字符串至少32位
LICENSE_ADMIN_SECRET=随机长字符串

# ========== 邮箱验证码（须配置 SMTP）==========
EMAIL_AUTH_ENABLED=true

SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=你的QQ号@qq.com
SMTP_PASSWORD=QQ邮箱SMTP授权码
# 仅填显示名（中文会自动编码）；留空则 From 为 SMTP_USER
SMTP_FROM=求职助手
SMTP_USE_SSL=true

# 163 邮箱示例
# SMTP_HOST=smtp.163.com
# SMTP_PORT=465
# SMTP_USER=你的邮箱@163.com
# SMTP_PASSWORD=163客户端授权码
# SMTP_FROM=求职助手 <你的邮箱@163.com>
# SMTP_USE_SSL=true

PAYMENT_MODE=personal_qr
PAYMENT_MOCK=false
PAYMENT_PERSONAL_QR=true

WECHAT_OAUTH_ENABLED=false
ALIPAY_OAUTH_ENABLED=false

API_HOST=127.0.0.1
API_PORT=8000
