# 求职助手 - 用户本机配置（无需修改数据库相关项）
DEPLOYMENT_ROLE=local
DB_BACKEND=sqlite
SQLITE_PATH=data/job_assistant.db

# 会员云服务地址（安装包已预填）
CLOUD_API_URL={{CLOUD_API_URL}}

AUTH_ENABLED=true
DEV_LOGIN_ENABLED=false

API_HOST=127.0.0.1
API_PORT=8000

DEFAULT_GREETING_STYLE=简洁
DAILY_GREETING_LIMIT=30

# 用户自备 DeepSeek API Key（设置页填写，也可在此预填）
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

RESUME_OCR_ENABLED=true
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=
