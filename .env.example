# ========== 用户本机版（release 默认）==========
# 岗位/简历自动存 SQLite，无需安装 MySQL

DEPLOYMENT_ROLE=local
DB_BACKEND=sqlite
SQLITE_PATH=data/job_assistant.db

# 本地阶段暂不连接会员云；恢复登录时取消注释并填写真实地址
# CLOUD_API_URL=https://你的会员云域名

AUTH_ENABLED=false

# AI 配置（用户自备 DeepSeek Key）
LLM_PROVIDER=deepseek
LLM_API_KEY=your_key_here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

API_HOST=127.0.0.1
API_PORT=8000

DEFAULT_GREETING_STYLE=简洁
DAILY_GREETING_LIMIT=30
